# Production / Staging environment variables (example)
# Copy to .env and fill values before deploying

# App
DOMAIN=yourdomain.example
STAGE=staging
NODE_ENV=production
JWT_SECRET=change_this_to_a_strong_secret

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/appdb

# Redis
REDIS_URL=redis://redis:6379

# Registry for images built by CI (GHCR or DockerHub)
DOCKER_REGISTRY=ghcr.io/your-org
DOCKER_USERNAME=
DOCKER_TOKEN=

# Email for TLS registration (Let's Encrypt)
LETSENCRYPT_EMAIL=admin@yourdomain.example

# Optional: SSH deploy host info (used by GH Actions if provided)
DEPLOY_SSH_HOST=your.server.ip
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=deploy
DEPLOY_SSH_KEY_SECRET_NAME=SSH_PRIVATE_KEY
